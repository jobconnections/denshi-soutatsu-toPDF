{
  "name": "denshi-soutatsu-pdf",
  "version": "1.0.0",
  "description": "e-Gov 電子送達 ZIP to PDF 変換ツール",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "bundle": "esbuild index.js --bundle --platform=node --target=node26 --outfile=dist/bundle.js --external:@aws-sdk/client-s3",
    "sea-blob": "node --experimental-sea-config sea-config.json",
    "build": "node build.js"
  },
  "keywords": [
    "egov",
    "pdf",
    "xslt"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "puppeteer-core": "^25.9.0",
    "saxon-js": "^2.7.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6"
  }
}
